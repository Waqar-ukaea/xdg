{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "$env{PRESET_CXX_FLAGS} $env{LLVM_CXX_FLAGS} $env{COMMON_CXX_FLAGS}",
        "XDG_CMAKE_PRESET": "${presetName}"
      },
      "environment": {
        "COMMON_CXX_FLAGS": ""
      }
    },
    {
      "name": "gprt_gcc_headless",
      "inherits": ["base"],
      "displayName": "GPRT GCC headless Vulkan build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "XDG_ENABLE_MOAB": "ON",
        "XDG_ENABLE_LIBMESH": "OFF",
        "XDG_ENABLE_EMBREE": "ON",
        "XDG_ENABLE_GPRT": "ON",
        "XDG_ENABLE_CUBQL": "OFF",
        "XDG_BUILD_TESTS": "ON",
        "XDG_BUILD_TOOLS": "ON",
        "GPRT_BUILD_SAMPLES": "OFF",
        "GPRT_BUILD_TESTS": "OFF",
        "GPRT_USE_INCLUDED_GLFW": "ON",
        "USE_HEADLESS": "ON"
      }
    },
    {
      "name": "llvm",
      "inherits": ["base"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "environment": {
        "LLVM_CXX_FLAGS": "-fopenmp -fopenmp-cuda-mode"
      }
    },
    {
      "name": "cubql_llvm_ada",
      "inherits": ["llvm"],
      "displayName": "cuBQL LLVM OpenMP offload RTX 2000 Ada",
      "cacheVariables": {
        "XDG_ENABLE_CUBQL": "ON"
      },
      "environment": {
        "PRESET_CXX_FLAGS": "-fopenmp-targets=nvptx64 -Xopenmp-target -march=sm_89"
      }
    },
    {
      "name": "nvhpc",
      "inherits": ["base"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "nvc",
        "CMAKE_CXX_COMPILER": "nvc++"
      }
    },
    {
      "name": "cubql_nvhpc_ada",
      "inherits": ["nvhpc"],
      "displayName": "cuBQL NVHPC OpenMP offload RTX 2000 Ada",
      "cacheVariables": {
        "XDG_ENABLE_CUBQL": "ON"
      },
      "environment": {
        "PRESET_CXX_FLAGS": "-mp=gpu -Minfo=mp -gpu=cc89"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gprt_gcc_headless",
      "configurePreset": "gprt_gcc_headless"
    },
    {
      "name": "cubql_llvm_ada",
      "configurePreset": "cubql_llvm_ada"
    },
    {
      "name": "cubql_nvhpc_ada",
      "configurePreset": "cubql_nvhpc_ada"
    }
  ]
}
